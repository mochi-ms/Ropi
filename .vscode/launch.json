{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Ropi",
      "type": "debugpy",
      "request": "launch",
      "module": "ropi",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
